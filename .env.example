# Cursor API keys (never commit real keys)
#
# Production / local secrets live OUTSIDE this repo, for example:
#   ~/.config/etorrefranca4-chart/env
#   ~/etorrefranca4-secrets/chart.env
# Or set CHART_ENV_FILE to an absolute path.
#
# Copy this template there (chmod 600), then fill values:

API_KEY1=
CURSOR_API_KEY=

