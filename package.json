{
  "name": "llm-generated-chart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3092 -H 127.0.0.1",
    "build": "next build",
    "export:hosting": "CHART_EXPORT=1 next build",
    "start": "next start -p 3092 -H 127.0.0.1",
