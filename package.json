{
  "name": "llm-generated-chart",
  "version": "0.1.0",
  "private": true,
  "description": "Static React showcase + Node API for AI Chart Generator",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "npm run build:server && CHART_PORT=3093 node server/dist/server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "CHART_PORT=3092 CHART_SERVE_STATIC=1 node server/dist/server.js",
    "serve:headless": "./serve.sh --headless --port=3092"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.5",
    "d3": "^7.9.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "5.7.2",
    "vite": "^6.2.0"
  }
}
